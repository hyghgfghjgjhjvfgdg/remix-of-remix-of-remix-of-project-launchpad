<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="bg">#FF0E0F12</color>
    <color name="card">#FF1B1C21</color>
    <color name="text">#FFF4F4F6</color>
    <color name="muted">#FF9A9BA3</color>
    <color name="accent">#FF7B4DFF</color>
    <style name="AppTheme" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:statusBarColor">@color/bg</item>
        <item name="android:navigationBarColor">@color/bg</item>
        <item name="android:colorAccent">@color/accent</item>
    </style>
    <style name="SplashTheme" parent="AppTheme">
        <item name="android:windowBackground">@color/bg</item>
    </style>
    <style name="PlayerTheme" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
    </style>
</resources>
